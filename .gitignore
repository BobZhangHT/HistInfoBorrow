# =============================================================================
# CAHB-PP Simulation Study - Git Ignore Rules
# =============================================================================
#
# Excludes generated files, caches, and large reference materials from version control.
# Only source code (.py files) and documentation are tracked.

# =============================================================================
# Python Generated Files
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# =============================================================================
# Simulation Artifacts (DO NOT COMMIT)
# =============================================================================

# Generated results (tables, plots, raw data)
results/
output/
*.csv
*.tex
*.pdf

# Simulation cache (for checkpointing)
.simulation_cache/
cache/
*.joblib

# Temporary data files
*.npy
*.npz
*.pkl
*.pickle

# =============================================================================
# Reference Papers and Large Files (DO NOT COMMIT)
# =============================================================================

# Reference PDFs should not be in version control (copyright)
references/
papers/
R Codes/
*.pdf

# Large data files
*.h5
*.hdf5
*.mat

# =============================================================================
# Virtual Environments
# =============================================================================

.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Conda environments
conda-env/
.conda/

# =============================================================================
# IDE and Editor Files
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# Spyder
.spyderproject
.spyproject

# =============================================================================
# Operating System Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.nfs*

# =============================================================================
# Logs and Temporary Files
# =============================================================================

*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# =============================================================================
# Documentation Build Files
# =============================================================================

docs/_build/
docs/_static/
docs/_templates/

# =============================================================================
# Testing and Coverage
# =============================================================================

.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# =============================================================================
# Keep These Files (Negative Patterns)
# =============================================================================

# Keep README and requirements
!README.md
!requirements.txt

# Keep all Python source files
!*.py

# Keep configuration files
!.gitignore
!.gitattributes

# =============================================================================
# Additional Notes
# =============================================================================
#
# To clean up ignored files locally:
#   git clean -fdX
#
# To see what would be removed:
#   git clean -fdXn
#
# To force-add an ignored file (if really needed):
#   git add -f filename
#
