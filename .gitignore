# =============================================================================
# RADISH — Git Ignore Rules
# =============================================================================
# Track:   source code (.py), c_src/, build_c.py, README, LICENSE, requirements
# Ignore:  generated results, raw data, caches, editors, PDFs, build artefacts

# ── Python byte-code & caches ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.nbi
*.nbc

# ── Build / packaging ────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
*.manifest
*.spec

# ── Generated outputs & caches ───────────────────────────────────────────────
results/
output/
tune_results/
cache/
.simulation_cache/
simulation_cache/
*.joblib
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.mat
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# ── Reference material / data (DO NOT COMMIT) ────────────────────────────────
references/
papers/
R Codes/
docs/
scripts/
*.pdf
*.csv
*.tex
*.Rdata
*.rda
*.rds
*.rtf

# `real_data/` holds non-redistributable HORIZON/FIT data + outputs.
# Track only the Python reproduction scripts (data must be obtained
# independently — see README §"Real-data application").
real_data/*
!real_data/*.py

# ── Virtual environments ─────────────────────────────────────────────────────
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/
conda-env/

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.vscode/
*.code-workspace
.idea/
*.iml
.ipynb_checkpoints/
*.ipynb
.spyderproject
.spyproject
.cursor/
.claude/

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*~
.nfs*

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# ── Allowlist (top-level repo essentials) ────────────────────────────────────
!README.md
!LICENSE
!requirements.txt
!.gitignore
!.gitattributes
