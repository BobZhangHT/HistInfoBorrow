"""
main.py

Main orchestration script for the CAHB-PP simulation study.

This script:
1. Loads configurations from `config.py`.
2. Sets up `joblib` for parallel execution and caching.
3. Sets up `tqdm` for progress bars.
4. Defines the function for a single simulation replicate.
5. Launches all simulation tasks in parallel.
6. Collects results and passes them to `analysis.py` for processing.
"""

import os
import sys
import numpy as np
import joblib
from tqdm import tqdm

# --- Add project root to path ---
# This allows imports like `import config`
sys.path.append(os.path.dirname(os.path.abspath(__file__)))

try:
    import config
    import data_generation
    import methods
    import analysis
except ImportError as e:
    print(f"Error: Could not import project modules. {e}")
    print("Please ensure all .py files are in the same directory.")
    sys.exit(1)

# --- Define the Single-Simulation Function ---

def run_single_simulation(scenario, method_name, replicate_id):
    """
    Executes a single replicate of a single scenario and method.
    This function is designed to be cached and run in parallel.
    
    NOTE: This implements a NON-response-adaptive loop to match
    the requested file structure. CAHB/CAHB-PP are proxied.
    """
    
    # 1. Set seed for reproducibility
    # Unique seed for every (scenario, method, replicate) combo
    seed = (scenario['id'] * 100000) + (config.METHODS_TO_RUN.index(method_name) * 10000) + replicate_id
    np.random.seed(seed)
    
    # 2. Generate historical data
    hist_data = data_generation.generate_historical_data(scenario['n_h'], scenario)
    
    # 3. Instantiate method
    try:
        MethodClass = getattr(methods, method_name)
        method = MethodClass(hist_data, scenario, config.PRIORS)
    except Exception as e:
        print(f"Error instantiating method {method_name}: {e}")
        return None

    # 4. Trial Simulation Loop
    
    # --- 4a. Burn-in Phase ---
    X_curr = data_generation.generate_covariates(config.N_INIT)
    Z_curr = np.random.binomial(1, config.ALLOC_BURN_IN, config.N_INIT)
    Y_curr = np.array([
        data_generation.generate_single_outcome(
            X_curr[i].reshape(1, -1),
            Z_curr[i],
            scenario['tau_0'],
            scenario['kappa']
        )
        for i in range(config.N_INIT)
    ])
    
    # --- 4b. Adaptive Allocation Phase ---
    n_adaptive = scenario['n'] - config.N_INIT
    for _ in range(n_adaptive):
        # Generate new subject
        X_new = data_generation.generate_covariates(1)
        
        # Get allocation probability from the method
        pi_1 = method.get_allocation_prob(X_curr, Y_curr, Z_curr, X_new)
        pi_1 = float(np.clip(pi_1, 0.0, 1.0))
        
        # Assign new subject
        Z_new = np.random.binomial(1, pi_1)
        
        # Add to trial data
        X_curr = np.vstack([X_curr, X_new])
        Z_curr = np.append(Z_curr, Z_new)
        Y_curr = np.append(
            Y_curr,
            data_generation.generate_single_outcome(
                X_new,
                Z_new,
                scenario['tau_0'],
                scenario['kappa']
            )
        )

    # --- 5. Final Analysis ---
    
    # Get estimates from the method
    try:
        delta_hat, ci_low, ci_high, prob_gt_0 = method.estimate_treatment_effect(
            X_curr, Y_curr, Z_curr
        )
    except Exception as e:
        # Catch errors in estimation (e.g., singular matrices)
        print(f"Warning: Estimation failed for {scenario['name']} rep {replicate_id}, method {method_name}. {e}")
        delta_hat, ci_low, ci_high, prob_gt_0 = np.nan, np.nan, np.nan, np.nan

    # 6. Collate Results
    result = {
        'scenario_id': scenario['id'],
        'scenario_name': scenario['name'],
        'method': method_name,
        'replicate_id': replicate_id,
        'n': scenario['n'],
        'n_h': scenario['n_h'],
        'tau_0': scenario['tau_0'],
        'delta_hat': delta_hat,
        'ci_low': ci_low,
        'ci_high': ci_high,
        'prob_gt_0': prob_gt_0,
        'n_total': scenario['n'],
        'n_treated': int(np.sum(Z_curr))
    }
    
    return result

# --- Main Orchestration ---

def main():
    """
    Main runner function.
    """
    print("--- CAHB-PP Simulation Study ---")
    
    # 1. Setup directories
    os.makedirs(config.CACHE_DIR, exist_ok=True)
    os.makedirs(config.RESULTS_DIR, exist_ok=True)
    os.makedirs(config.PLOTS_DIR, exist_ok=True)
    os.makedirs(config.TABLES_DIR, exist_ok=True)
    
    # 2. Setup Caching
    memory = joblib.Memory(config.CACHE_DIR, verbose=0)
    
    # Use config flag to bypass caching if desired
    if config.USE_CACHE:
        cached_run_single = memory.cache(run_single_simulation)
    else:
        cached_run_single = run_single_simulation

    # 3. Get scenario definitions
    scenarios = config.get_scenario_definitions()
    print(f"Loaded {len(scenarios)} scenarios.")
    print(f"Comparing {len(config.METHODS_TO_RUN)} methods.")
    print(f"Running {config.N_REPLICATES} replicates per scenario.")
    
    # 4. Create task list
    tasks = []
    for s in scenarios:
        for m in config.METHODS_TO_RUN:
            for r in range(config.N_REPLICATES):
                tasks.append(joblib.delayed(cached_run_single)(s, m, r))
                
    print(f"Total tasks: {len(tasks)}")

    # 5. Run tasks in parallel with progress bar
    print(f"Running simulations (using {config.N_JOBS} jobs)...")
    results = joblib.Parallel(n_jobs=config.N_JOBS)(
        tqdm(tasks, desc="Simulating")
    )
    
    # Filter out potential None results from errors
    results = [r for r in results if r is not None]
    
    if not results:
        print("Error: All simulations failed. Please check for errors.")
        return

    print("Simulations complete. Processing results...")
    
    # 6. Process results
    summary_df = analysis.process_results(results)
    
    # 7. Generate outputs
    analysis.generate_tables(summary_df)
    analysis.generate_plots(summary_df)
    
    print("--- Simulation Finished Successfully ---")
    print(f"Results, tables, and plots are saved in: {config.RESULTS_DIR}")

if __name__ == "__main__":
    main()
